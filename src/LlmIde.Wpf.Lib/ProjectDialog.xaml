<Window x:Class="LlmIde.Wpf.Lib.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로젝트"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Malgun Gothic">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ProjectIdLabel"
                   Grid.Row="0"
                   Grid.Column="0"
                   Text="pID"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,12,12" />
        <TextBox x:Name="ProjectIdTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 FontSize="16"
                 Margin="0,0,0,12" />

        <TextBlock x:Name="ProjectNameLabel"
                   Grid.Row="1"
                   Grid.Column="0"
                   Text="이름"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,12,12" />
        <TextBox x:Name="ProjectNameTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 FontSize="16"
                 Margin="0,0,0,12" />

        <TextBlock x:Name="ProjectPathLabel"
                   Grid.Row="2"
                   Grid.Column="0"
                   Text="경로"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,12,12" />
        <Grid x:Name="ProjectPathRow"
              Grid.Row="2"
              Grid.Column="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="88" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ProjectPathTextBox"
                     Grid.Column="0"
                     FontSize="16"
                     Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="찾기"
                    Height="30"
                    Click="BrowsePathButton_Click" />
        </Grid>

        <CheckBox x:Name="ConversationTypeCheckBox"
                  Grid.Row="4"
                  Grid.ColumnSpan="2"
                  Visibility="Collapsed"
                  IsChecked="True"
                  Content="대화종류: 장기 대화 (체크 해제 시 1회성 대화)"
                  FontSize="14"
                  Margin="0,0,0,12" />

        <TextBlock x:Name="DeleteNoticeText"
                   Grid.Row="5"
                   Grid.ColumnSpan="2"
                   Visibility="Collapsed"
                   Text="안내: 정말 삭제하시겠습니까? 이 결정은 되돌릴 수 없습니다."
                   FontSize="16"
                   TextWrapping="Wrap"
                   Margin="0,4,0,12" />

        <TextBlock x:Name="DeleteApiKeyNoticeText"
                   Grid.Row="6"
                   Grid.ColumnSpan="2"
                   Visibility="Collapsed"
                   Text="사용중인 API 키도 같이 삭제됩니다."
                   FontSize="16"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <CheckBox x:Name="ConfirmApiKeyCheckBox"
                  Grid.Row="7"
                  Grid.ColumnSpan="2"
                  Visibility="Collapsed"
                  Content="사용중인 API 키도 같이 삭제됩니다."
                  FontSize="14"
                  Margin="0,0,0,12" />

        <StackPanel Grid.Row="8"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton"
                    Content="확인"
                    Width="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="ConfirmButton_Click" />
            <Button Content="취소"
                    Width="88"
                    Height="34"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
