<Window x:Class="LlmIde.Wpf.ToolManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도구관리"
        Width="640"
        Height="520"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Malgun Gothic">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="LLM이 사용할 수 있는 도구 목록입니다. (조회 전용 — 도구는 코드에서 구현됩니다.)"
                   FontSize="13"
                   Foreground="#555555"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <ListView x:Name="ToolList"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,10">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Arguments, StringFormat=인자: {0}}"
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Button Grid.Row="2"
                Content="닫기"
                Width="88"
                Height="34"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="CloseButton_Click" />
    </Grid>
</Window>
