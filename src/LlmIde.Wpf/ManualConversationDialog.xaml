<Window x:Class="LlmIde.Wpf.ManualConversationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="대화 수동 추가"
        Width="760"
        Height="600"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Malgun Gothic">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="다른 세션 등에서 진행한 대화를 붙여넣어 완료된 대화처럼 추가합니다. (실제 LLM 호출은 하지 않습니다.)"
                   FontSize="13"
                   Foreground="#555555"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Text="user:"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />
        <TextBox x:Name="UserTextBox"
                 Grid.Row="2"
                 FontSize="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12" />

        <TextBlock Grid.Row="3"
                   Text="assistant:"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />
        <TextBox x:Name="AssistantTextBox"
                 Grid.Row="4"
                 FontSize="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="추가"
                    Width="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="AddButton_Click" />
            <Button Content="취소"
                    Width="88"
                    Height="34"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
