<Window x:Class="LlmIde.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM IDE"
        Width="1536"
        Height="768"
        MinWidth="1200"
        MinHeight="640"
        Background="White"
        FontFamily="Malgun Gothic"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="GuideBlueBrush" Color="#4D8EDB" />
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="22,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="124" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GuideBlueBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="90" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                BorderThickness="1,1,1,1">
            <Menu>
                <MenuItem Header="프로젝트">
                    <MenuItem Header="생성"
                              Click="CreateProjectMenuItem_Click" />
                    <MenuItem Header="이름변경"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="RenameProjectMenuItem_Click" />
                    <MenuItem Header="삭제"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="DeleteProjectMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="편집">
                    <MenuItem Header="아티팩트 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="ArtifactRuleMenuItem_Click" />
                    <MenuItem Header="압축 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="CompressionRuleMenuItem_Click" />
                    <MenuItem Header="시스템 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="SystemRuleMenuItem_Click" />
                    <MenuItem Header="중요도 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="ImportanceRuleMenuItem_Click" />
                    <MenuItem Header="API 키 입력"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="ApiKeyMenuItem_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="298" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="296" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="1,0,1,1">
                <Grid Margin="27,30,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="프로젝트목록"
                               FontSize="24"
                               Margin="0,0,0,22" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject}"
                             SelectionChanged="ProjectList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="23" />
                                    <TextBlock Text="{Binding PId}" FontSize="13" Foreground="#666666" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="0,0,1,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource GuideBlueBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Margin="56,28,20,0">
                            <TextBlock Text="선택된 대화 목록"
                                       FontSize="24" />
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Conversations}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="중요도&#x0a;(0~10)"
                                                Binding="{Binding ImportanceWeight}"
                                                Width="150" />
                            <DataGridTemplateColumn Header="[일시]&#x0a;사용자&#x0a;발화내용"
                                                    Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CreatedAtText}"
                                                       FontSize="17" />
                                            <TextBlock Text="{Binding UserContent}"
                                                       FontSize="22"
                                                       TextWrapping="Wrap"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LLM&#x0a;응답내용&#x0a;(마크다운 포맷)"
                                                Binding="{Binding AssistantContent}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="자동스크롤바"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="24"
                               Margin="0,0,38,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="0,0,1,1">
                <Grid Margin="16,30,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="아티팩트 목록"
                               FontSize="24"
                               Margin="0,0,0,28" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Artifacts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,14,18">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="22"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="13"
                                               Foreground="#666666" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
