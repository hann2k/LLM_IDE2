<Window x:Class="LlmIde.Wpf.ProjectCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로젝트 생성"
        Width="520"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Malgun Gothic">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="pID"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,12,12" />
        <TextBox x:Name="ProjectIdTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 FontSize="16"
                 Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="이름"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,12,12" />
        <TextBox x:Name="ProjectNameTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 FontSize="16"
                 Margin="0,0,0,12" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="경로"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,0,12,12" />
        <Grid Grid.Row="2"
              Grid.Column="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="88" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ProjectPathTextBox"
                     Grid.Column="0"
                     FontSize="16"
                     Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="찾기"
                    Height="30"
                    Click="BrowsePathButton_Click" />
        </Grid>

        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="생성"
                    Width="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="CreateButton_Click" />
            <Button Content="취소"
                    Width="88"
                    Height="34"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
