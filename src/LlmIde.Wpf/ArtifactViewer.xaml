<Window x:Class="LlmIde.Wpf.ArtifactViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        Title="아티팩트 뷰어"
        Width="820"
        Height="600"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Malgun Gothic">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Markdown rendering for prose artifacts (Markdown, Table, Plan, Review, ...). -->
        <markdig:MarkdownViewer x:Name="MarkdownContent"
                                Grid.Row="0"
                                FontSize="15"
                                Margin="0,0,0,12" />

        <!-- Fixed-width code viewer for code artifacts (Code, Json, Patch, Command, Config, Log). -->
        <TextBox x:Name="CodeContent"
                 Grid.Row="0"
                 FontSize="14"
                 FontFamily="Consolas, D2Coding, Malgun Gothic"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Visibility="Collapsed"
                 Margin="0,0,0,12" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="복사"
                    Width="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="CopyButton_Click" />
            <Button Content="닫기"
                    Width="88"
                    Height="34"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
