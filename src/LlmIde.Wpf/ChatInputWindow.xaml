<Window x:Class="LlmIde.Wpf.ChatInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="입력창"
        Width="820"
        Height="320"
        MinWidth="420"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Malgun Gothic"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="UserRow" Height="*" />
            <RowDefinition x:Name="AssistantRow" Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="프로바이더"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <ComboBox x:Name="ProviderComboBox"
                      Width="170"
                      FontSize="13"
                      VerticalAlignment="Center"
                      SelectionChanged="ProviderComboBox_SelectionChanged" />
            <CheckBox x:Name="ManualModeCheckBox"
                      Content="수동대화 추가"
                      FontSize="13"
                      VerticalAlignment="Center"
                      Margin="18,0,0,0"
                      Checked="ManualModeCheckBox_Changed"
                      Unchecked="ManualModeCheckBox_Changed" />
        </StackPanel>

        <TextBox x:Name="UserInput"
                 Grid.Row="1"
                 MinHeight="60"
                 FontSize="18"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 PreviewKeyDown="UserInput_PreviewKeyDown" />

        <Grid x:Name="AssistantInputArea"
              Grid.Row="2"
              Visibility="Collapsed"
              Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="assistant:"
                       FontSize="13"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="AssistantInput"
                     Grid.Row="1"
                     MinHeight="60"
                     FontSize="16"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="HintText"
                       Text="Enter: 전송   Shift+Enter: 줄바꿈   ESC: 닫기"
                       FontSize="13"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />
            <Button x:Name="RegisterButton"
                    Content="등록"
                    Width="80"
                    Height="30"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    Click="RegisterButton_Click" />
        </Grid>
    </Grid>
</Window>
