<Window x:Class="LlmIde.Wpf.Writer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LlmIde.Wpf.Writer"
        xmlns:lib="clr-namespace:LlmIde.Wpf.Lib;assembly=LlmIde.Wpf.Lib"
        Title="LLM IDE"
        Width="1536"
        Height="768"
        MinWidth="1200"
        MinHeight="640"
        Background="White"
        FontFamily="Malgun Gothic"
        Loaded="Window_Loaded">
    <Window.CommandBindings>
        <CommandBinding Command="Save"
                        CanExecute="SaveCommand_CanExecute"
                        Executed="SaveCommand_Executed" />
    </Window.CommandBindings>
    <Window.Resources>
        <SolidColorBrush x:Key="GuideBlueBrush" Color="#4D8EDB" />
        <lib:ImportanceToDeleteVisibilityConverter x:Key="ImportanceToDeleteVisibilityConverter" />
        <local:WidthFractionConverter x:Key="WidthFractionConverter" />
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="22,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GuideBlueBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Style.Triggers>
                <!-- Use a soft light-gray selection instead of the default blue highlight. -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEEEEE" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                BorderThickness="1,1,1,1">
            <Menu>
                <MenuItem Header="프로젝트">
                    <MenuItem Header="생성"
                              Click="CreateProjectMenuItem_Click" />
                    <MenuItem Header="이름변경"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="RenameProjectMenuItem_Click" />
                    <MenuItem Header="복제"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="CloneProjectMenuItem_Click" />
                    <MenuItem Header="삭제"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="DeleteProjectMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="저장"
                              Command="Save"
                              InputGestureText="Ctrl+S" />
                </MenuItem>
                <MenuItem Header="편집">
                    <MenuItem Header="기준"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="CriteriaMenuItem_Click" />
                    <MenuItem Header="LLM"
                              Click="LlmMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="도구관리"
                          Click="ToolManagerMenuItem_Click" />
            </Menu>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProjectColumn" Width="220" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="ChatColumn" Width="460" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 프로젝트 목록 -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="1,0,1,1">
                <ListBox ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         SelectionChanged="ProjectList_SelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PId}" FontSize="13" Foreground="#666666" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="#E3E9F2"
                          DragCompleted="LayoutSplitter_DragCompleted" />

            <!-- 중앙: 위(목차 | 본문) / 아래(아티팩트 카드) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition x:Name="ArtifactRow" Height="170" MinHeight="80" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="OutlineColumn" Width="320" MinWidth="160" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource PanelBorderStyle}"
                            BorderThickness="0,0,1,1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,4" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="목차"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#444444"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="추가" FontSize="11" Padding="6,1" Margin="2,0,0,0" Click="OutlineAdd_Click" />
                                    <Button Content="하위" FontSize="11" Padding="6,1" Margin="2,0,0,0" Click="OutlineAddChild_Click" />
                                    <Button Content="이름" FontSize="11" Padding="6,1" Margin="2,0,0,0" Click="OutlineRename_Click" />
                                    <Button Content="삭제" FontSize="11" Padding="6,1" Margin="2,0,0,0" Click="OutlineDelete_Click" />
                                </StackPanel>
                            </DockPanel>
                            <TreeView ItemsSource="{Binding OutlineItems}"
                                      BorderThickness="0"
                                      FontSize="16"
                                      AllowDrop="True"
                                      SelectedItemChanged="OutlineTree_SelectedItemChanged"
                                      PreviewMouseRightButtonDown="OutlineTree_PreviewMouseRightButtonDown"
                                      PreviewMouseLeftButtonDown="OutlineTree_PreviewMouseLeftButtonDown"
                                      MouseMove="OutlineTree_MouseMove"
                                      DragOver="OutlineTree_DragOver"
                                      Drop="OutlineTree_Drop">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OutlineItem_MouseDoubleClick" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="추가" Click="OutlineAdd_Click" />
                                        <MenuItem Header="하위 추가" Click="OutlineAddChild_Click" />
                                        <MenuItem Header="이름 변경" Click="OutlineRename_Click" />
                                        <MenuItem Header="삭제" Click="OutlineDelete_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type local:OutlineItem}"
                                                              ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Number}"
                                                       Foreground="#666666"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <Grid>
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="140"
                                                         IsVisibleChanged="OutlineEditBox_IsVisibleChanged"
                                                         KeyDown="OutlineEditBox_KeyDown"
                                                         LostFocus="OutlineEditBox_LostFocus">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="#E3E9F2"
                                  DragCompleted="LayoutSplitter_DragCompleted" />

                    <Border Grid.Column="2"
                            Style="{StaticResource PanelBorderStyle}"
                            BorderThickness="0,0,1,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="본문"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#444444"
                                       Margin="8,6" />
                            <Grid>
                                <TextBox Text="{Binding BodyText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsBodyEditable}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Padding="10"
                                         FontSize="14" />
                                <TextBlock Text="목차를 선택하면 본문을 편집할 수 있습니다."
                                           Foreground="#AAAAAA"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBodyEditable}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Background="#E3E9F2"
                              DragCompleted="LayoutSplitter_DragCompleted" />

                <Border Grid.Row="2"
                        Style="{StaticResource PanelBorderStyle}"
                        BorderThickness="0,0,1,1">
                    <DockPanel>
                        <ListBox ItemsSource="{Binding Artifacts}"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="190"
                                            Margin="6"
                                            Padding="10"
                                            Background="White"
                                            BorderBrush="{StaticResource GuideBlueBrush}"
                                            BorderThickness="1"
                                            MouseLeftButtonUp="ArtifactItem_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Type}"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SourceRequestId, StringFormat=대화 {0}}"
                                                       FontSize="12"
                                                       Foreground="#999999" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="#E3E9F2"
                          DragCompleted="LayoutSplitter_DragCompleted" />

            <!-- 우: 대화(로그 + 입력) 도킹 -->
            <Border Grid.Column="4"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="0,0,1,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition x:Name="ComposerRow" Height="150" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ConversationGrid"
                             Grid.Row="0"
                             ItemsSource="{Binding Conversations}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6">
                                    <!-- 사용자: 우측 박스 (시간 / 발화 / 중요도 / 삭제) -->
                                    <Border HorizontalAlignment="Right"
                                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.72}"
                                            Margin="0,0,0,6"
                                            Padding="8"
                                            Background="#F2F6FC"
                                            BorderBrush="{StaticResource GuideBlueBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CreatedAtText}"
                                                       FontSize="11"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Right" />
                                            <TextBox Text="{Binding UserContent, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     TextAlignment="Right"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     Margin="0,4,0,0"
                                                     FontSize="12"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Value, ElementName=ImportanceSlider, StringFormat={}{0:0}}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0" />
                                                <Slider x:Name="ImportanceSlider"
                                                        Width="84"
                                                        Minimum="0"
                                                        Maximum="10"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding DataContext.IsImportanceEditable, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                        Value="{Binding ImportanceWeight, Mode=TwoWay}"
                                                        ValueChanged="ImportanceSlider_ValueChanged"
                                                        Thumb.DragCompleted="ImportanceSlider_DragCompleted" />
                                                <Button Content="삭제"
                                                        FontSize="10"
                                                        Height="20"
                                                        Padding="6,1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding ImportanceWeight, Converter={StaticResource ImportanceToDeleteVisibilityConverter}}"
                                                        Click="DeleteConversationButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- LLM: 좌측 박스 -->
                                    <Border HorizontalAlignment="Left"
                                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Converter={StaticResource WidthFractionConverter}, ConverterParameter=0.82}"
                                            Margin="0,0,0,0"
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="{StaticResource GuideBlueBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="답변중">
                                                                <Setter Property="Foreground" Value="#C25E00" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="실패">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="답변완료 · 빈 응답">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <RichTextBox lib:MarkdownText.Text="{Binding AssistantContent}"
                                                         IsReadOnly="True"
                                                         IsDocumentEnabled="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         FontSize="12"
                                                         VerticalScrollBarVisibility="Disabled"
                                                         HorizontalScrollBarVisibility="Disabled">
                                                <RichTextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="아티팩트로 추출"
                                                                  Click="ExtractArtifactMenuItem_Click" />
                                                    </ContextMenu>
                                                </RichTextBox.ContextMenu>
                                            </RichTextBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="#E3E9F2"
                                  DragCompleted="LayoutSplitter_DragCompleted" />
                    <Grid Grid.Row="2" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="ProviderSelector"
                                  Grid.Row="0"
                                  Margin="0,0,0,4"
                                  FontSize="12"
                                  SelectionChanged="ProviderSelector_SelectionChanged" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComposerInput"
                                     Grid.Column="0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="13"
                                     KeyDown="ComposerInput_KeyDown" />
                            <Button Grid.Column="1"
                                    Content="전송"
                                    Width="64"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Click="ComposerSend_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
