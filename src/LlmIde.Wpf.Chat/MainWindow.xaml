<Window x:Class="LlmIde.Wpf.Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LlmIde.Wpf.Chat"
        xmlns:lib="clr-namespace:LlmIde.Wpf.Lib;assembly=LlmIde.Wpf.Lib"
        Title="LLM IDE"
        Width="1536"
        Height="768"
        MinWidth="1200"
        MinHeight="640"
        Background="White"
        FontFamily="Malgun Gothic"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GuideBlueBrush" Color="#4D8EDB" />
        <lib:ImportanceToDeleteVisibilityConverter x:Key="ImportanceToDeleteVisibilityConverter" />
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="22,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GuideBlueBrush}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Style.Triggers>
                <!-- Use a soft light-gray selection instead of the default blue highlight. -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEEEEE" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="BorderBrush" Value="{StaticResource GuideBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                BorderThickness="1,1,1,1">
            <Menu>
                <MenuItem Header="프로젝트">
                    <MenuItem Header="생성"
                              Click="CreateProjectMenuItem_Click" />
                    <MenuItem Header="이름변경"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="RenameProjectMenuItem_Click" />
                    <MenuItem Header="복제"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="CloneProjectMenuItem_Click" />
                    <MenuItem Header="삭제"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="DeleteProjectMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="편집">
                    <MenuItem Header="기준"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="CriteriaMenuItem_Click" />
                    <MenuItem Header="아티팩트 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="ArtifactRuleMenuItem_Click" />
                    <MenuItem Header="압축 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="CompressionRuleMenuItem_Click" />
                    <MenuItem Header="시스템 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="SystemRuleMenuItem_Click" />
                    <MenuItem Header="중요도 룰"
                              IsEnabled="{Binding HasSelectedProject}"
                              Click="ImportanceRuleMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="도구관리"
                          Click="ToolManagerMenuItem_Click" />
            </Menu>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="298" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="296" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="1,0,1,1">
                <ListBox ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         SelectionChanged="ProjectList_SelectionChanged"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PId}" FontSize="13" Foreground="#666666" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Panel.ZIndex="1"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="0,0,1,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ConversationGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Conversations}"
                              IsReadOnly="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="중요도&#x0a;(0~10)"
                                                    Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="6">
                                            <TextBlock Text="{Binding Value, ElementName=ImportanceSlider, StringFormat={}{0:0}}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12" />
                                            <Slider x:Name="ImportanceSlider"
                                                    Minimum="0"
                                                    Maximum="10"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    IsEnabled="{Binding DataContext.IsImportanceEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Value="{Binding ImportanceWeight, Mode=TwoWay}"
                                                    Margin="0,8,0,0"
                                                    ValueChanged="ImportanceSlider_ValueChanged"
                                                    Thumb.DragCompleted="ImportanceSlider_DragCompleted" />
                                            <Button Content="삭제"
                                                    FontSize="12"
                                                    Height="28"
                                                    Margin="0,12,0,0"
                                                    Visibility="{Binding ImportanceWeight, Converter={StaticResource ImportanceToDeleteVisibilityConverter}}"
                                                    Click="DeleteConversationButton_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="[일시]&#x0a;사용자&#x0a;발화내용"
                                                    Width="250"
                                                    IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RequestId, StringFormat=ID {0}}"
                                                       FontSize="12"
                                                       Foreground="#666666" />
                                            <TextBlock Text="{Binding CreatedAtText}"
                                                       FontSize="12" />
                                            <TextBox Text="{Binding UserContent, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     Margin="0,12,0,0"
                                                     FontSize="12"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LLM&#x0a;응답내용&#x0a;(마크다운 포맷)"
                                                    IsReadOnly="True"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Margin="6,4,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="답변중">
                                                                <Setter Property="Foreground" Value="#C25E00" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="실패">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="답변완료 · 빈 응답">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <RichTextBox lib:MarkdownText.Text="{Binding AssistantContent}"
                                                         IsReadOnly="True"
                                                         IsDocumentEnabled="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         Margin="6"
                                                         FontSize="12"
                                                         VerticalScrollBarVisibility="Disabled"
                                                         HorizontalScrollBarVisibility="Disabled">
                                                <RichTextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="아티팩트로 추출"
                                                                  Click="ExtractArtifactMenuItem_Click" />
                                                    </ContextMenu>
                                                </RichTextBox.ContextMenu>
                                            </RichTextBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    BorderThickness="0,0,1,1">
                <ListBox ItemsSource="{Binding Artifacts}"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,14,18"
                                        Background="Transparent"
                                        MouseLeftButtonUp="ArtifactItem_Click">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Type}"
                                           FontSize="13"
                                           Foreground="#666666" />
                                <TextBlock Text="{Binding SourceRequestId, StringFormat=대화 {0}}"
                                           FontSize="13"
                                           Foreground="#666666" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
