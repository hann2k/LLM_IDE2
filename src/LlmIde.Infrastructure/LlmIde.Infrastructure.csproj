<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LlmIde.Core\LlmIde.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- Override DocumentFormat.OpenXml's vulnerable transitive System.IO.Packaging 8.0.0 (NU1903). -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.0" />
    <!-- Required transitive dependency of the local Framework.Common.dll (not auto-resolved for a bare DLL reference). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supervisor-supplied local library (file logging via Framework.Common.Logger.Log; TCP comm for later use). -->
    <Reference Include="Framework.Common">
      <HintPath>$(MSBuildThisFileDirectory)..\..\package\Lib.Net10\Framework.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
